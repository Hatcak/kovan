# Copy to .env.local and fill in. .env.local is git-ignored: never commit real keys.

# Public URL of the site (used in docs examples, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo credits every workspace starts with
KOVAN_START_CREDITS=500

# Optional, server-only: raises GitHub's rate limit for the github.repo tool.
# Never prefix provider secrets with NEXT_PUBLIC_, that would ship them to the browser.
GITHUB_TOKEN=
